# Local Ollama on the host, accessed from Docker.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=local-ollama
LLM_MODEL=qwen3.8:27b

TEMPERATURE=0
MAX_TOKENS=1536
CONTEXT_CHARS=14000
TOP_K=6
MAX_WORKERS=1
LLM_TIMEOUT=180
LLM_ATTEMPTS=1

WEB_PORT=8768
WEB_RETRIEVAL_MODE=n2
DEMO_MODE=true
OPERATOR_TOKEN=local-demo-operator
